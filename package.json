{
  "name": "question-seg-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "试题结构化切分引擎骨架（MinerU 后处理）——版面层 + 语言层双层组合规则，垂直演进模型的起点",
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "daily": "tsx scripts/daily.ts",
    "view": "tsx scripts/view-server.ts",
    "view:server": "tsx scripts/view-server.ts",
    "stages:export": "tsx scripts/export-stages.ts",
    "stages": "npm run stages:export && npm run view:server",
    "view:cap": "node scripts/view-cap.mjs",
    "view:test": "node scripts/browser-gate.mjs",
    "audit:render": "node scripts/audit-render.mjs",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run audit:render && npm run audit:numbering && npm run bank:all",
    "stages:ocr-fill": "tsx scripts/ocr-fill.ts",
    "stages:ocr-page": "tsx scripts/ocr-page-fill.ts",
    "audit:numbering": "tsx scripts/audit-numbering.ts",
    "bank": "tsx scripts/build-bank.ts",
    "audit:attribution": "tsx scripts/audit-attribution.ts",
    "report:generalization": "tsx scripts/generalization.ts",
    "bank:all": "tsx scripts/bank-all.ts"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.2.0",
    "adm-zip": "^0.6.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "undici": "^8.12.3"
  }
}
